# Copy to .dev.vars for `wrangler dev`, and set the secrets in production with `wrangler secret put NAME`.
# NEVER commit real values. .dev.vars and .env are git-ignored.

# --- Gateway authentication (required) -------------------------------------------------
# HS256 shared secret (>= 32 chars). Generate: openssl rand -base64 48
GATEWAY_JWT_SECRET=
# OR validate tokens from your IdP (Okta / Entra ID / Auth0) with a JWKS URL instead:
# GATEWAY_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# GATEWAY_JWT_ISSUER=https://idp.example.com/
# GATEWAY_JWT_AUDIENCE=salesforce-codemode

# --- Mode ---------------------------------------------------------------------------------
# mock (default): built-in fake org. live: real Salesforce via per-user OAuth.
SF_MODE=mock
# Lets the dashboard mint demo tokens. MUST be false outside local demos; ignored/forbidden in live mode.
ALLOW_DEV_TOKENS=true

# --- Salesforce OAuth (live mode) ------------------------------------------------------
# Production: https://login.salesforce.com   Sandbox: https://test.salesforce.com   or your My Domain URL
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
# Optional for External Client Apps using PKCE only; required for secret-based Connected Apps.
SF_CLIENT_SECRET=
# Must match the callback URL registered on the Connected App / External Client App exactly.
SF_REDIRECT_URI=https://salesforce-codemode-gateway.<your-subdomain>.workers.dev/oauth/callback
SF_API_VERSION=v66.0
# 32 random bytes, base64. Encrypts Salesforce tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Optional: Claude API for free-form code generation in the Playground -----------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: execution policy overrides (JSON) -------------------------------------
# EXECUTION_POLICY_JSON={"maxRecordsPerQuery":100,"writesRequireApproval":true,"maxCpuMs":1000,"approvedAgents":["Service_Triage_Agent"]}

# --- Optional: prompt-injection guardrail policy (JSON). See docs/prompt-injection-guardrails.md ---
# GUARDRAIL_POLICY_JSON={"mode":"enforce","blockWritesAfterInjection":true,"actions":{"system_prompt_spoof":"block"}}

# --- Optional: OpenTelemetry traces (Phoenix / Langfuse / Jaeger / Tempo). See docs/observability.md ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of public:secret>
# OTEL_SERVICE_NAME=salesforce-codemode-gateway
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_CAPTURE_CONTENT=false   # never true in live mode

# --- Optional: evals (npm run evals) ---
# EVAL_JUDGE_MODEL=claude-opus-5-5
# EVAL_AGENT_MODEL=claude-opus-5-5
